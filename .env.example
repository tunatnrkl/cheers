# Sitenin açık adresi (sitemap, OAuth yönlendirmesi ve Origin kontrolü için)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL — hesap, ilerleme ve yapay zeka önbelleği için
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pokerdefteri

# Claude API — yalnızca sunucuda okunur, tarayıcıya asla gönderilmez
ANTHROPIC_API_KEY=
# İsteğe bağlı: varsayılan claude-opus-5-5
AI_MODEL=

# İsteğe bağlı: Google ile giriş (boşsa buton gizlenir)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
